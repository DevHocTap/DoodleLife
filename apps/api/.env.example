# Sao chép thành apps/api/.env — KHÔNG commit file .env thật.
# Chỉ điền key của provider sẽ dùng để thử C01; key chưa có thì để trống.

# Provider mặc định cho C03/C05: cloudflare | gemini | openai | stability | replicate
# Mặc định cloudflare (miễn phí, Sếp chốt 06/11/2026); Gemini là đường nâng cấp trả phí.
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI (FLUX.1 schnell) — miễn phí 10.000 neurons/ngày.
# Lấy ở dashboard Cloudflare → trang Workers AI → Use REST API →
# Create a Workers AI API Token (token) + Account ID. Không cần thẻ.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Google Gemini (Nano Banana 2 / Pro) — lấy ở Google AI Studio.
# Lưu ý: tạo ảnh qua Gemini API KHÔNG có free tier (cần billing);
# chỉ dùng làm đường nâng cấp trả phí khi Cloudflare không đạt.
GEMINI_API_KEY=
# Model Gemini: gemini-nano-banana-2.1 (Google khuyên dùng cho dự án mới;
# gemini-3.1-flash-image đã deprecated) hoặc gemini-3-pro-image (Nano Banana Pro)
GEMINI_MODEL=gemini-nano-banana-2.1

# OpenAI (gpt-image-2 — gpt-image-1 đã tắt 23/10/2026)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2

# Stability AI (SD3 / SD3.5)
STABILITY_API_KEY=
STABILITY_MODEL=sd3.5-flash

# Replicate (FLUX)
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Supabase (dùng sau cho C04 — chưa bắt buộc ở Sprint 1 scaffold)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=doodlelife-private

PORT=3001
